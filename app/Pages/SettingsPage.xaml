<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Papyrus.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24,16,24,32" Spacing="16" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource PageTitleStyle}" />

            <!-- Replay buffer -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Replay buffer" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ToggleSwitch x:Name="BufferSwitch" OnContent="On" OffContent="Off" Toggled="BufferSwitch_Toggled" />
                    <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
                    <Button x:Name="SaveNowButton" Content="Save clip now" Click="SaveNow_Click" />
                    <ToggleSwitch x:Name="AlwaysOnSwitch" Header="Always on: start Papyrus when Windows starts and turn the replay buffer on"
                                  Toggled="Setting_Toggled" />
                </StackPanel>
            </Border>

            <!-- What and how to record -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Text="Recording" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ComboBox x:Name="ModeBox" Header="Record" Width="340" SelectionChanged="Setting_SelectionChanged">
                        <ComboBoxItem Content="Fullscreen apps and games only" />
                        <ComboBoxItem Content="Whole screen (desktop too)" />
                    </ComboBox>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Save hotkey" />
                        <Button x:Name="HotkeyButton" Width="340" HorizontalContentAlignment="Left" Click="HotkeyButton_Click" KeyDown="HotkeyButton_KeyDown" LostFocus="HotkeyButton_LostFocus" />
                        <TextBlock Style="{StaticResource CaptionStyle}" Text="Click the box, then press the keys you want, for example Ctrl + Shift + F9. Press Esc to cancel." />
                    </StackPanel>
                    <ComboBox x:Name="LengthBox" Header="Clip length" Width="340" SelectionChanged="Setting_SelectionChanged">
                        <ComboBoxItem Content="15 seconds" Tag="15" />
                        <ComboBoxItem Content="30 seconds" Tag="30" />
                        <ComboBoxItem Content="1 minute" Tag="60" />
                        <ComboBoxItem Content="1.5 minutes" Tag="90" />
                        <ComboBoxItem Content="2 minutes" Tag="120" />
                    </ComboBox>
                    <ComboBox x:Name="FpsBox" Header="Frame rate" Width="340" SelectionChanged="Setting_SelectionChanged">
                        <ComboBoxItem Content="120 fps" Tag="120" />
                        <ComboBoxItem Content="60 fps" Tag="60" />
                        <ComboBoxItem Content="30 fps" Tag="30" />
                    </ComboBox>
                    <ComboBox x:Name="QualityBox" Header="Quality" Width="340" SelectionChanged="Setting_SelectionChanged">
                        <ComboBoxItem Content="4K (2160p)" Tag="2160" />
                        <ComboBoxItem Content="1440p" Tag="1440" />
                        <ComboBoxItem Content="1080p" Tag="1080" />
                        <ComboBoxItem Content="720p" Tag="720" />
                        <ComboBoxItem Content="480p" Tag="480" />
                    </ComboBox>
                    <TextBlock x:Name="EstimateText" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource CaptionStyle}"
                               Text="Changing clip length, frame rate, quality or the microphone while recording restarts the buffer, so what was in it is lost." />
                </StackPanel>
            </Border>

            <!-- Sound -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Sound" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock TextWrapping="Wrap" Text="The game, Spotify and Discord each get their own sound track. No other app is recorded." />
                    <ToggleSwitch x:Name="MicSwitch" Header="Record my microphone too, as a separate track" Toggled="Setting_Toggled" />
                </StackPanel>
            </Border>

            <!-- Where clips go -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Clips location" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Name="ClipsLocationText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <Button Content="Open clips folder" Click="OpenFolder_Click" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="VersionText" Style="{StaticResource CaptionStyle}" />
        </StackPanel>
    </ScrollViewer>
</Page>
