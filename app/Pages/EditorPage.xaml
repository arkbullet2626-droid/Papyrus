<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Papyrus.Pages.EditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="RootPanel" Padding="24,16,24,32" Spacing="12" MaxWidth="1100" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="BackButton" Click="Back_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72B;" FontSize="14" />
                        <TextBlock Text="Back to clips" />
                    </StackPanel>
                </Button>
                <TextBlock Text="Editor" Style="{StaticResource PageTitleStyle}" VerticalAlignment="Center" />
            </StackPanel>

                <Border CornerRadius="8" Background="Black">
                    <MediaPlayerElement x:Name="Player" Height="430" AreTransportControlsEnabled="True" AutoPlay="False" />
                </Border>

                <TextBlock x:Name="ClipTitle" Text="" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />

                <!-- Clip length -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="8">
                        <Grid>
                            <TextBlock Text="Clip" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                            <TextBlock x:Name="LengthLabel" Text="" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <Grid x:Name="VideoBarHost" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button x:Name="PlaySelectionButton" Content="Play the selected part" Click="PlaySelection_Click" IsEnabled="False" />
                            <Button x:Name="ResetButton" Content="Reset" Click="Reset_Click" IsEnabled="False" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource CaptionStyle}"
                                   Text="Drag the bar on each side to cut the clip. The left bar moves in 1-second steps so the picture can be copied without losing any quality. Click anywhere on a strip to jump there." />
                    </StackPanel>
                </Border>

                <!-- Sound tracks -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Sound tracks" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="NoTracksLabel" Text="This clip has no sound." Style="{StaticResource CaptionStyle}" />
                        <StackPanel x:Name="TracksPanel" Spacing="16" />
                        <TextBlock Style="{StaticResource CaptionStyle}"
                                   Text="Each strip shows how loud that track is over time. Drag its side bars to choose when the track is heard. Listen picks which track you hear while previewing; untick Keep to leave a track out of the saved clip. Changing the volume re-encodes that track only." />
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button x:Name="SaveButton" Content="Save as a new clip" Style="{StaticResource AccentButtonStyle}" Click="Save_Click" IsEnabled="False" />
                    <Button x:Name="DeleteButton" Content="Delete this clip" Click="Delete_Click" IsEnabled="False" />
                    <ProgressRing x:Name="Busy" IsActive="False" Width="24" Height="24" />
                </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
